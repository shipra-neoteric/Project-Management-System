# Copy to .env and fill in. Never commit .env.
PORT=4000
# MongoDB Atlas connection string (include the database name, e.g. /pms)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pms?retryWrites=true&w=majority
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

# --- Email (optional) -------------------------------------------------------------------
# Without SMTP_HOST, emails (notifications, password reset, verification) are printed to the
# server log instead of being sent. Free options: Brevo (300/day), or a Gmail "app password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Project Management System <no-reply@yourcompany.com>
# Public URL of the frontend used in email links (defaults to the first FRONTEND_URL)
APP_URL=

# --- Single sign-on (optional, OpenID Connect) -------------------------------------------
# Callback URL to register with the provider: <this API>/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Nexora
OIDC_AUTO_CREATE_USERS=false
OIDC_ALLOWED_DOMAINS=
